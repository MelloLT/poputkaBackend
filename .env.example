NODE_ENV=development
PORT=5000
JWT_SECRET=            # >=16 chars, required in production
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=          # comma-separated extra origins

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

PAYMENT_SERVICE_URL=
# Same value must be set in payment-service (sent as x-internal-secret)
INTERNAL_API_SECRET=   # >=16 chars

# SMS gateway (production)
SMS_GATEWAY_URL=
SMS_LOGIN=
SMS_PASSWORD=

# Test stand only: returns OTP code in API response
OTP_DEBUG_MODE=false
